---
import Base from '../layouts/Base.astro';
import StarRating from '../components/StarRating.astro';
import { companies, getComparisons } from '../data/companies';
import { SITE, NICHE } from '../config';
import { SERVICE_LABELS } from '../lib/companies';

const comparisons = getComparisons();
const year = new Date().getFullYear();

// Truncate to n words with an ellipsis, but only append "..." when truncation
// actually happened — otherwise a short bestFor that already ends in "." would
// render as "....". Untruncated strings get exactly one trailing period.
function truncateWords(s: string, n: number): string {
  const clean = s.replace(/\.+$/, '');
  const words = clean.split(' ');
  return words.length > n ? words.slice(0, n).join(' ') + '...' : clean + '.';
}

// Title Case for the homepage <title>/H1 only — NICHE.providersLabel is stored
// lowercase because it also reads correctly mid-sentence (e.g. "36 companies
// reviewed"); this capitalizes it just for the heading-style usage below.
const SMALL_WORDS = new Set(['a', 'an', 'the', 'in', 'at', 'on', 'for', 'of', 'to', 'by', 'with', 'from', 'as', 'and', 'or', 'but', 'nor']);
const titleCase = (str: string) => str.split(' ').map((word, i) => {
  const lower = word.toLowerCase();
  return (i > 0 && SMALL_WORDS.has(lower)) ? lower : lower.charAt(0).toUpperCase() + lower.slice(1);
}).join(' ');
const providersLabelTC = titleCase(NICHE.providersLabel);

// Top-rated companies used in featured profiles section
const featuredProfiles = [...companies].sort((a, b) => b.rating - a.rating).slice(0, 10);

// Hand-curated, non-overlapping "Best for X" categories for the quick-answer
// box — top-rated agency is always "overall"; the other 5 cover genuinely
// distinct real differentiators from this list.
const quickAnswerPicks: { slug: string; label: string }[] = [
  { slug: "quantumblack", label: "overall" },
  { slug: "bcg-x", label: "large in-house build capacity" },
  { slug: "tensorway", label: "agencies that also handle the build" },
  { slug: "n-ix", label: "named enterprise clients like Bosch and Siemens" },
  { slug: "valiance-solutions", label: "government and public-sector engagements" },
  { slug: "softkraft", label: "startup budgets" },
];

// All unique engagement models across companies — auto-generates table columns so they always match the data
const allEngagementModels = [...new Set(companies.flatMap(c => c.engagementModels))].sort();
---

<Base
  title={`Best ${NICHE.label} ${providersLabelTC} in ${year}`}
  description={`Compare ${NICHE.label} ${NICHE.providersLabel} by pricing, stack, and use case.`}
  canonical={`${SITE.url}/`}
>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-stone-900 to-brand-900 py-14 sm:py-20">
    <div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-24 w-[28rem] h-[28rem] rounded-full bg-brand-500/30 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -left-24 w-[28rem] h-[28rem] rounded-full bg-brand-400/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white leading-tight mb-4">
        Best {NICHE.label} {providersLabelTC} in {year}
      </h1>
      <p class="text-lg sm:text-xl text-stone-300 max-w-2xl mx-auto mb-6">
        Independent reviews of {companies.length} {NICHE.providersLabel} selected for verified delivery track records, technical expertise, and transparent pricing data.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-6">
        <a href="#comparison-table" class="bg-brand-500 text-white font-semibold px-6 py-3 rounded-xl hover:bg-brand-400 transition-colors">
          Compare all {NICHE.providersLabel}
        </a>
      </div>
      <div class="flex flex-wrap gap-3 justify-center text-xs text-stone-300">
        <span class="bg-white/10 border border-white/20 backdrop-blur-sm px-3 py-1 rounded-full">{companies.length} {NICHE.providersLabel} reviewed</span>
        <span class="bg-white/10 border border-white/20 backdrop-blur-sm px-3 py-1 rounded-full">Independent editorial</span>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">

    <!-- QUICK ANSWER BOX -->
    <div class="bg-brand-50 border border-brand-200 rounded-2xl p-6 mb-12">
      <h2 class="text-lg font-bold text-stone-900 mb-3">Which {NICHE.label} {NICHE.providerLabel} is best?</h2>
      <p class="text-sm text-stone-600 mb-3">Short answer: the right choice depends on whether you need boardroom-level credibility, hands-on build capacity, or a budget that fits a smaller team.</p>
      <ul class="space-y-2 text-sm text-stone-700">
        {quickAnswerPicks.map(pick => {
          const c = companies.find(co => co.slug === pick.slug)!;
          return (
            <li>
              <span class="font-semibold">Best {pick.label === 'overall' ? 'overall' : `for ${pick.label}`}:</span>{' '}
              <a href={`/companies/${c.slug}/`} class="text-brand-600 hover:underline">{c.name}</a>
              {': '}{c.primaryDifferentiator}
            </li>
          );
        })}
      </ul>
    </div>

    <!-- TABLE 1: MASTER COMPARISON -->
    <section id="comparison-table" class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">How do the top {NICHE.label} {NICHE.providersLabel} compare?</h2>
      <p class="text-stone-600 mb-6 text-sm">The table below covers all {companies.length} reviewed {NICHE.providersLabel}.</p>
      <div class="overflow-x-auto rounded-2xl border border-stone-200">
        <table class="w-full text-sm table-fixed">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-4 py-3 font-semibold text-stone-700 w-[16%]">Company</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700 w-[30%]">Best for</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700 w-[22%]">Pricing model</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700 w-[18%]">Min. engagement</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700 w-[14%]">Rating</th>
            </tr>
          </thead>
          <tbody>
            {companies.map((c, i) => (
              <tr class={`border-b border-stone-100 hover:bg-stone-50 transition-colors ${c.featured ? 'border-l-4 border-l-brand-600 bg-brand-50/40' : ''}`}>
                <td class="px-4 py-3">
                  <div class="flex flex-col items-start gap-1">
                    <a href={`/companies/${c.slug}/`} class="font-semibold text-brand-600 hover:underline">{c.name}</a>
                    {c.featured && <span class="text-xs bg-brand-600 text-white px-2 py-0.5 rounded-full">Editor's pick</span>}
                  </div>
                </td>
                <td class="px-4 py-3 text-stone-600">{c.bestFor}</td>
                <td class="px-4 py-3 text-stone-600">{c.pricingModel}</td>
                <td class="px-4 py-3 text-stone-600">{c.minimumEngagement}</td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="flex items-center gap-1.5">
                    <StarRating rating={c.rating} />
                    <span class="font-semibold text-stone-900">{c.rating.toFixed(1)}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- SEO PROSE 1: WHAT MAKES A GOOD PROVIDER -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-4">What makes a good {NICHE.label} {NICHE.providerLabel}?</h2>
      <div class="prose-custom max-w-none text-sm text-stone-700 space-y-4">
        <p>Most buyers start an agency search with a long list pulled from a Google search or a peer recommendation, and the first cut should have nothing to do with pricing. It should be whether the agency has ever recommended against a project. Every agency on a shortlist will say yes to a discovery call; the ones worth a second call can name a specific engagement where they told a client not to build something.</p>
        <p>Agency size correlates with brand safety, not with the quality of the advice you'll actually get. A 20-person boutique with a named methodology and no separate implementation business to protect can be more candid than a 300,000-person firm whose AI practice needs to hit a revenue target this quarter. Neither is automatically the right pick; the point is that "who's the biggest name" is a weak filter for this specific decision.</p>
        <p>Ask every agency on your shortlist the same question and compare the answers side by side: what's an AI project you turned down, and why? A generic answer, or no answer at all, tells you more about how this engagement will go than anything in a pitch deck.</p>
      </div>
    </section>

    <!-- TABLE: TECH STACK BY COMPANY -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">What tech stack does each {NICHE.providerLabel} use?</h2>
      <p class="text-stone-600 mb-6 text-sm">Short answer: specialists typically cover more tools than generalists. Check each profile for full tech stack details.</p>
      <div class="overflow-x-auto rounded-2xl border border-stone-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-4 py-3 font-semibold text-stone-700 whitespace-nowrap">Company</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Primary tech stack</th>
            </tr>
          </thead>
          <tbody>
            {companies.map((c, i) => (
              <tr class={`border-b border-stone-100 hover:bg-stone-50 ${i % 2 === 1 ? 'bg-stone-50/40' : ''}`}>
                <td class="px-4 py-3 font-semibold"><a href={`/companies/${c.slug}/`} class="text-brand-600 hover:underline">{c.name}</a></td>
                <td class="px-4 py-3 text-stone-600">{c.techStack.slice(0, 5).join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- HOW WE SELECTED -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-4">How we selected these {NICHE.label} {NICHE.providersLabel}</h2>
      <p class="text-stone-600 mb-3 text-sm">Each {NICHE.providerLabel} on this list was selected using the same criteria a buyer should apply when building an RFP shortlist. The criteria used for selection in {year} are:</p>
      <ul class="list-disc list-inside space-y-2 text-sm text-stone-600">
        <li><strong>Advisory independence:</strong> Some evidence the agency has recommended against a project, not just for one</li>
        <li><strong>Named enterprise engagements:</strong> Verifiable clients or case studies, not just industry names on a homepage</li>
        <li><strong>Documented methodology:</strong> A repeatable, named process for assessment, not a one-off proposal template</li>
        <li><strong>Strategy-to-build continuity:</strong> A clear path from recommendation to implementation, in-house or via disclosed handoff</li>
        <li><strong>Engagement transparency:</strong> At least one disclosed engagement model with enough pricing context to plan a project</li>
      </ul>
    </section>

    <!-- COMPANY PROFILES -->
    <section id="all-profiles" class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Best {NICHE.label} {NICHE.providersLabel} in {year}</h2>
      <p class="text-stone-600 mb-8 text-sm">Featured profiles for the top-rated {NICHE.providersLabel}. Full reviews available for all {companies.length} {NICHE.providersLabel} via their profile pages.</p>
      <div class="space-y-8">
        {featuredProfiles.map((c, i) => (
          <div class={`border rounded-2xl p-6 ${c.featured ? 'border-brand-300 bg-brand-50/30' : 'border-stone-200'}`}>
            <div class="flex items-start justify-between gap-4 flex-wrap mb-3">
              <div>
                <div class="flex items-center gap-3 mb-1">
                  <h3 class="text-xl font-bold text-stone-900">
                    <a href={`/companies/${c.slug}/`} class="hover:text-brand-600">{i + 1}. {c.name}</a>
                  </h3>
                  {c.featured && <span class="text-xs bg-brand-600 text-white px-2 py-0.5 rounded-full shrink-0">Editor's pick</span>}
                </div>
                <p class="text-sm text-stone-500 italic">{c.tagline}</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <StarRating rating={c.rating} />
                <span class="font-bold text-stone-900">{c.rating.toFixed(1)}</span>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4 text-xs text-stone-600">
              <div><span class="font-semibold text-stone-500 block">Founded</span>{c.founded}</div>
              <div><span class="font-semibold text-stone-500 block">HQ</span>{c.hq}</div>
              <div><span class="font-semibold text-stone-500 block">Team size</span>{c.teamSize}</div>
              <div><span class="font-semibold text-stone-500 block">Min. engagement</span>{c.minimumEngagement}</div>
            </div>

            <p class="text-sm text-stone-700 mb-4">{c.description}</p>

            <div class="flex flex-wrap gap-1.5 mb-4">
              {c.techStack.slice(0, 6).map(t => (
                <span class="text-xs bg-stone-100 text-stone-600 px-2 py-0.5 rounded">{t}</span>
              ))}
            </div>

            <div class="grid sm:grid-cols-2 gap-4 mb-4 text-sm">
              <div>
                <p class="font-semibold text-stone-700 mb-1">Advantages</p>
                <ul class="space-y-1">
                  {c.pros.slice(0, 3).map(p => (
                    <li class="flex items-start gap-1.5 text-stone-600"><span class="text-green-600 font-bold shrink-0">+</span>{p}</li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="font-semibold text-stone-700 mb-1">Things to consider</p>
                <ul class="space-y-1">
                  {c.cons.map(con => (
                    <li class="flex items-start gap-1.5 text-stone-600"><span class="text-red-400 font-bold shrink-0">-</span>{con}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="flex items-center justify-between flex-wrap gap-3">
              <p class="text-xs text-stone-500"><span class="font-semibold">Best for:</span> {c.bestFor}</p>
              <div class="flex gap-2">
                <a href={`/companies/${c.slug}/`} class="text-sm font-semibold text-brand-600 hover:underline">Full review</a>
                <span class="text-stone-300">|</span>
                <a href={c.website} target="_blank" rel="noopener noreferrer nofollow" class="text-sm font-semibold text-stone-600 hover:text-brand-600">Visit website</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- TABLE 2: BY USE CASE -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Best {NICHE.label} {NICHE.providersLabel} by use case</h2>
      <p class="text-stone-600 mb-6 text-sm">Short answer: the best {NICHE.providerLabel} depends on your specific use case. The table below maps common use cases to the most suitable firms in {year}.</p>
      <div class="overflow-x-auto rounded-2xl border border-stone-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Use case</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Recommended {NICHE.providerLabel}</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Why</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700 whitespace-nowrap">Min. engagement</th>
            </tr>
          </thead>
          <tbody>
            {companies.slice(0, 7).map((c, i) => (
              <tr class={`border-b border-stone-100 hover:bg-stone-50 ${i % 2 === 1 ? 'bg-stone-50/50' : ''}`}>
                <td class="px-4 py-3 font-medium text-stone-800">{c.useCases[0] ?? 'TODO: Add use case'}</td>
                <td class="px-4 py-3"><a href={`/companies/${c.slug}/`} class="text-brand-600 hover:underline">{c.name}</a></td>
                <td class="px-4 py-3 text-stone-600">{c.primaryDifferentiator}</td>
                <td class="px-4 py-3 text-stone-600">{c.minimumEngagement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABLE 3: HOW TO CHOOSE -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">How to choose a {NICHE.label} {NICHE.providerLabel}</h2>
      <p class="text-stone-600 mb-6 text-sm">Short answer: build a shortlist of three to five agencies, then vet each on independence, methodology, and named engagements before a single pricing conversation.</p>
      <div class="overflow-x-auto rounded-2xl border border-stone-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Criterion</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Why it matters</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">What to ask on the vetting call</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Red flag</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-stone-100 hover:bg-stone-50">
              <td class="px-4 py-3 font-medium text-stone-800">Advisory independence</td>
              <td class="px-4 py-3 text-stone-600">An agency that only sells implementation has an incentive to recommend building something</td>
              <td class="px-4 py-3 text-stone-600">Can you tell me about a project you talked a client out of?</td>
              <td class="px-4 py-3 text-stone-600">Every past engagement ended in a build recommendation</td>
            </tr>
            <tr class="border-b border-stone-100 hover:bg-stone-50 bg-stone-50/50">
              <td class="px-4 py-3 font-medium text-stone-800">Documented methodology</td>
              <td class="px-4 py-3 text-stone-600">A named, repeatable process produces comparable results across engagements</td>
              <td class="px-4 py-3 text-stone-600">Walk me through your assessment process step by step</td>
              <td class="px-4 py-3 text-stone-600">Process description is vague or invented on the spot</td>
            </tr>
            <tr class="border-b border-stone-100 hover:bg-stone-50">
              <td class="px-4 py-3 font-medium text-stone-800">Named enterprise engagements</td>
              <td class="px-4 py-3 text-stone-600">Verified engagements separate real delivery from marketing-driven case studies</td>
              <td class="px-4 py-3 text-stone-600">Can I speak to a named reference client directly?</td>
              <td class="px-4 py-3 text-stone-600">Case studies name only industries, never specific clients</td>
            </tr>
            <tr class="border-b border-stone-100 hover:bg-stone-50 bg-stone-50/50">
              <td class="px-4 py-3 font-medium text-stone-800">Strategy-to-build continuity</td>
              <td class="px-4 py-3 text-stone-600">A roadmap that ignores implementation reality gets thrown out during the build phase</td>
              <td class="px-4 py-3 text-stone-600">Who owns the handoff from strategy to build, and what does that look like?</td>
              <td class="px-4 py-3 text-stone-600">No clear answer for what happens after the strategy phase ends</td>
            </tr>
            <tr class="border-b border-stone-100 hover:bg-stone-50">
              <td class="px-4 py-3 font-medium text-stone-800">Engagement transparency</td>
              <td class="px-4 py-3 text-stone-600">A strategy phase with no defined scope or timeline tends to run indefinitely</td>
              <td class="px-4 py-3 text-stone-600">What's the deliverable and timeline for the first phase specifically?</td>
              <td class="px-4 py-3 text-stone-600">Agency resists committing to a fixed first-phase timeline</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- SEO PROSE 2 -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-4">{NICHE.label} in {year}: what buyers should know</h2>
      <div class="prose-custom max-w-none text-sm text-stone-700 space-y-4">
        <p>Agencies in this category split into two camps that don't always announce themselves clearly. One camp is dedicated AI agencies, boutiques and mid-size firms built around AI from the start. The other is AI practices bolted onto much larger, older organizations, the Big Four, the global systems integrators, the strategy houses. Both can do excellent work; the mistake is assuming brand size predicts advisory quality, or that a small agency name you haven't heard of predicts the opposite.</p>
        <p>A shortlist built purely from Google search results and cold outreach tends to overweight whoever spends the most on content marketing, not whoever gives the most useful advice. That's a known pattern worth actively correcting for: an agency's search visibility and its actual delivery track record are two different signals, and the ranking table on this page deliberately weighs verified engagements and methodology over marketing reach.</p>
        <p>Reference calls matter more here than in most procurement categories. A named client willing to talk for fifteen minutes about what the agency actually recommended, and whether that recommendation held up six months later, tells you more than any case study page. If an agency can't produce one, that's data too.</p>
      </div>
    </section>

    <!-- TABLE 9: ENGAGEMENT MODELS BY COMPANY (columns auto-generated from data) -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">Which engagement models does each {NICHE.providerLabel} offer?</h2>
      <p class="text-stone-600 mb-6 text-sm">Short answer: most {NICHE.providersLabel} offer more than one engagement model. Use this table to filter by your preferred structure.</p>
      <div class="overflow-x-auto rounded-2xl border border-stone-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Company</th>
              {allEngagementModels.map(m => (
                <th class="text-center px-4 py-3 font-semibold text-stone-700 whitespace-nowrap">{m}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {companies.map((c, i) => (
              <tr class={`border-b border-stone-100 hover:bg-stone-50 ${i % 2 === 1 ? 'bg-stone-50/40' : ''}`}>
                <td class="px-4 py-3 font-semibold"><a href={`/companies/${c.slug}/`} class="text-brand-600 hover:underline">{c.name}</a></td>
                {allEngagementModels.map(m => (
                  <td class={`px-4 py-3 text-center font-semibold ${c.engagementModels.includes(m) ? 'text-green-600' : 'text-stone-300'}`}>
                    {c.engagementModels.includes(m) ? '✓' : '–'}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABLE 4: PRICING -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-stone-900 mb-2">{NICHE.label} pricing in {year}</h2>
      <p class="text-stone-600 mb-6 text-sm">Short answer: a standalone strategy engagement typically costs less and takes less time than a full build. Contact each {NICHE.providerLabel} directly for project-specific quotes.</p>
      <div class="overflow-x-auto rounded-2xl border border-stone-200">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200">
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Engagement model</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Typical cost range</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Timeline</th>
              <th class="text-left px-4 py-3 font-semibold text-stone-700">Best for</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-stone-100 hover:bg-stone-50">
              <td class="px-4 py-3 font-medium text-stone-800">Strategy / readiness assessment</td>
              <td class="px-4 py-3 text-stone-600">$15K – $60K</td>
              <td class="px-4 py-3 text-stone-600">3 – 8 weeks</td>
              <td class="px-4 py-3 text-stone-600">Use-case prioritization before committing to a build</td>
            </tr>
